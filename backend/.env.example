# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API Rate Limiting (Free tier: 15 requests per minute)
GEMINI_RATE_LIMIT_DELAY=0  # optional extra seconds before Gemini requests

# Data Processing Optimization
MAX_REDDIT_POSTS=50        # Maximum posts to analyze (増量: 30→50)
MAX_TEXT_LENGTH=25000      # Maximum character limit for analysis (増量: 15k→25k)
REDDIT_FETCH_LIMIT=150     # Reddit API fetch limit (新規追加: より多くのデータを取得)

# Reddit API (Required for OAuth authentication)
# Get your credentials from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=EmotiGift/1.0 by YourRedditUsername

# Server Configuration
# HOST=0.0.0.0
# PORT=8000

# CORS設定 (カンマ区切りで複数のオリジンを指定可能)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Abuse protection
# Per-client rate limit for analysis endpoints (slowapi syntax, ";" separates multiple limits)
# ANALYZE_RATE_LIMIT=5/minute;50/day
# Number of trusted reverse proxies in front of the app (reads X-Forwarded-For from the right).
# Render: Cloudflare + load balancer = 2. Too low shares one limit across all users,
# too high lets clients spoof their IP. Verify after deploying.
# TRUSTED_PROXY_HOPS=2
# Maximum characters accepted for uploaded chat history
# MAX_CHAT_CONTENT_CHARS=1000000
# Gemini call timeout (seconds) and max simultaneous Gemini calls
# GEMINI_REQUEST_TIMEOUT=60
# GEMINI_MAX_CONCURRENT=3
